# Mail Service Domain
MAIL_DOMAIN=tormag.kz
MAIL_SERVER_HOST=mail.tormag.kz

# Ports (change if occupied on your host)
STALWART_SMTP_PORT=25
STALWART_SMTPS_PORT=465
STALWART_SUBMISSION_PORT=587
STALWART_IMAP_PORT=993

# Web UI Ports
STALWART_ADMIN_PORT=8880   # Admin panel (8880 avoids conflict with gateway on 8080)
ROUNDCUBE_PORT=8890        # Webmail
