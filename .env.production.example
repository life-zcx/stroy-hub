POSTGRES_USER=tormag_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tormag
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://example.com,https://www.example.com
MAX_UPLOAD_SIZE_MB=5
GATEWAY_PORT=8080

# SMTP settings (VK WorkSpace / Mail.ru)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=info@tormag.kz
SMTP_PASS=your-app-password

# Cloudflare R2 Storage Settings
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=tormag-media
R2_PUBLIC_URL=https://media.tormag.kz

# Google AI Studio API Key for "Tormag AI" Chatbot Assistant
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash


