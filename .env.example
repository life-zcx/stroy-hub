# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Шаблон переменных окружения для Tormag.kz backend
#
# ВНИМАНИЕ: Этот файл НЕ содержит реальных секретов.
# Скопируйте его в .env и заполните своими значениями.
# Никогда не коммитьте реальный .env в git.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── База данных PostgreSQL ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Минимум 32 случайных байта: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── CORS / домены ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Электронная почта (Resend) ────────────────────────────────────────────────
# Получить на https://resend.com
RESEND_API_KEY=re_REPLACE_ME

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD

# ── Cloudflare R2 (хранилище файлов) ─────────────────────────────────────────
R2_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-custom-r2-domain.example.com

# ── Google Gemini AI ──────────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# ── SMSC (SMS-рассылки) ───────────────────────────────────────────────────────
SMSC_APIKEY=REPLACE_WITH_SMSC_KEY

# ── Telegram уведомления ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
TELEGRAM_API_ID=REPLACE_WITH_API_ID
TELEGRAM_API_HASH=REPLACE_WITH_API_HASH

# ── AI микросервис ────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:5005

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Максимум запросов в минуту на IP (по умолчанию: 300 в проде, 5000 в dev)
# GLOBAL_RATE_LIMIT=300
# Отключить rate limiting (только для тестов!):
# DISABLE_RATE_LIMIT=true
