# Редирект сторонних доменов на основной сайт
adkulan.shop, www.adkulan.shop,
hr-payroll.quest, www.hr-payroll.quest,
kaaspi.shop, www.kaaspi.shop,
pizda.asia, www.pizda.asia,
cs2tournaments.asia, www.cs2tournaments.asia,
adkulan.ru, www.adkulan.ru {
        redir https://tormag.kz{uri} permanent
}

# --- Основной сайт tormag.kz ---
tormag.kz, www.tormag.kz {
        # Reverse proxy to the Docker Gateway container
        reverse_proxy 127.0.0.1:8080

        # Compression for text assets
        encode gzip zstd

        # Basic logging
        log {
                output file /var/log/caddy/tormag_access.log
        }
}

# --- Личный кабинет ---
cabinet.tormag.kz {
        reverse_proxy 127.0.0.1:8080

        encode gzip zstd

        log {
                output file /var/log/caddy/cabinet_access.log
        }
}

# --- Веб-почта Roundcube ---
mail.tormag.kz {
    reverse_proxy 127.0.0.1:8890

    encode gzip zstd

    log {
        output file /var/log/caddy/mail_access.log
    }
}

# --- Панель управления Stalwart ---
panel.mail.tormag.kz {
    reverse_proxy 127.0.0.1:8080

    encode gzip zstd

    log {
        output file /var/log/caddy/panel_mail_access.log
    }
}


